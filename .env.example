# 설정 예시 파일. 이걸 .env 로 복사해서 값을 채운다.
# 실제 값이 든 .env 는 git 에 올라가지 않는다.

# Neon(또는 다른 Postgres)의 pooled 연결 문자열. host 에 -pooler 가 붙은 쪽을 쓴다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# 세션 쿠키 서명 키
AUTH_SECRET="여기에 openssl rand -base64 32 결과를 넣는다"

# 두 사람 계정. 이름은 자유롭게 바꾸고 나서 npm run db:seed 를 다시 실행하면 된다.
SEED_USER_A_SLUG="zeons"
SEED_USER_A_NAME="나"
SEED_USER_A_PASSWORD="원하는 비밀번호"

SEED_USER_B_SLUG="partner"
SEED_USER_B_NAME="너"
SEED_USER_B_PASSWORD="원하는 비밀번호"

# 카카오 개발자 앱에서 발급한다 (책 검색 + 장소 검색 + 지도).
# https://developers.kakao.com 에서 앱 추가 후 [앱 키] 메뉴에서 복사한다.
KAKAO_REST_API_KEY=""
NEXT_PUBLIC_KAKAO_JS_KEY=""

# 업로드된 사진은 프로젝트의 ./uploads 에 저장된다 (git 에 올라가지 않는다).
