# 설정 예시 파일. 이걸 .env 로 복사해서 값을 채운다.
# 실제 값이 든 .env 는 git 에 올라가지 않는다.

# Neon(또는 다른 Postgres)의 pooled 연결 문자열. host 에 -pooler 가 붙은 쪽을 쓴다.
# sslmode 는 verify-full 로 둔다. node-postgres 가 sslmode=require 의 동작을 바꾸는 중이라
# 명시하지 않으면 경고가 뜨고, 나중에 인증서 검증이 꺼질 수 있다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=verify-full"

# 세션 쿠키 서명 키
AUTH_SECRET="여기에 openssl rand -base64 32 결과를 넣는다"

# 두 사람 계정. 이름은 자유롭게 바꾸고 나서 npm run db:seed 를 다시 실행하면 된다.
SEED_USER_A_SLUG="zeons"
SEED_USER_A_NAME="나"
SEED_USER_A_PASSWORD="원하는 비밀번호"

SEED_USER_B_SLUG="partner"
SEED_USER_B_NAME="너"
SEED_USER_B_PASSWORD="원하는 비밀번호"

# 카카오 개발자 앱에서 발급한다 (책 검색 + 장소 검색 + 지도).
# https://developers.kakao.com 에서 앱 추가 후 [앱 키] 메뉴에서 복사한다.
KAKAO_REST_API_KEY=""
NEXT_PUBLIC_KAKAO_JS_KEY=""

# --- 사진 저장소 ---------------------------------------------------------
# 비워두면 로컬 ./uploads 에 저장한다. 개발은 이대로 두면 된다.
# 운영(NODE_ENV=production)에서는 반드시 채워야 한다.
# Vercel 같은 서버리스는 파일시스템이 휘발성이라 비워두면 사진이 사라진다.
#
# Cloudflare R2 기준 (S3 호환이면 어디든 된다):
#   S3_ENDPOINT        = https://<계정ID>.r2.cloudflarestorage.com
#   S3_REGION          = auto   (R2 는 리전 개념이 없다)
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# 버킷을 공개했거나 도메인을 연결했다면 그 주소. 채우면 이미지 요청이
# 서버 함수를 거치지 않아 빠르고, R2 는 이그레스가 무료다.
# 비워두면 /api/photos 라우트가 대신 읽어서 내려준다.
PHOTO_PUBLIC_BASE_URL=""
